name: "scribe-agent"
version: 1
release: 2.5
enabled: true
fallback: null
maxInputBytes: 1048576
version tags[0]: "core"
version tags[1]: "reader"
version tags[2]: "writer"
label: "café 你好"
rawText: "naïve – ✓ ok"
mixed[0]: "x"
mixed[1]: 1
mixed[2]: false
mixed[3]: null
mixed[4].deep.n: -42
matrix[0][0]: 1
matrix[0][1]: 2
matrix[1][0]: 3
matrix[1][1][0]: 4
matrix[1][1][1]: 5
bigInt: -9223372036854775807
avogadro: 6.022e+23
tiny: -0.5
quarter: 0.25
zero: 0
description: "The scribe agent reads a subject document and summarizes it.\nIt handles \"quotes\", backslashes \\ and trailing spaces freely.\n\"\"\" a literal three-quote run.\n  Two leading spaces are kept on this line."
pipeline.stages[0].name: "tokenize"
pipeline.stages[0].params.maxTokens: 4096
pipeline.stages[0].params.filter.stopWords[0]: "the"
pipeline.stages[0].params.filter.stopWords[1]: "and"
pipeline.stages[0].output.kind: "stream"
pipeline.stages[0].output.channels[0]: "text"
pipeline.stages[0].output.channels[1]: "meta"
pipeline.stages[1].name: "summarize"
pipeline.stages[1].params.model: "hoon-mini"
pipeline.stages[1].params.temperature: 0.2
pipeline.stages[1].params.topK: 40
pipeline.stages[1].params.hexTest: 42
pipeline.stages[1].params.negHex: -255
pipeline.stages[1].empty: {}
pipeline.stages[1].tags: []
pipeline.hooks.onStart.run: "bash"
pipeline.hooks.onStart.args[0]: "mkdir"
pipeline.hooks.onStart.args[1]: "-p"
pipeline.hooks.onStart.args[2]: "/tmp/scribe"
pipeline.hooks.onFinish: null
ui.panel width: 40
ui.layout.type: "split"
ui.layout.direction: "horizontal"
ui.2-levels: true
